# Runtime data. NEVER commit this: app.db holds the accounts (password hashes)
# and everyone's timeline; settings.json and secret.key hold secrets.
backend/data/

# Build output.
backend/static/
frontend/dist/

# Dependencies.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# The test suite's throwaway directory (backend/pytest.ini points at it).
backend/.pytest-tmp/

# Backups written by update.sh.
backups/

# Your own container settings (see the .example next to it).
deploy/container/docker-compose.override.yml

# Hand-off zips and scratch files.
*.zip
*.log

# Editors / OS.
.vscode/
.idea/
Thumbs.db
.DS_Store
